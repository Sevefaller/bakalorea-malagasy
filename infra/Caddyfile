{$SITE_ADDRESS:80} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
        -Server
    }
    @websocket path /app/*
    handle @websocket {
        reverse_proxy reverb:8080
    }
    @api path /api/* /up
    handle @api {
        root * /srv/backend/public
        php_fastcgi backend:9000
    }
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
    log {
        output file /data/access.log {
            roll_size 10MiB
            roll_keep 3
        }
    }
}

APP_NAME=Bakalorea
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:5173
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
DB_CONNECTION=sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=reverb
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLIC_PORT=8080
REVERB_PUBLIC_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=none
ADMIN_FINISHED_RETENTION_DAYS=30
